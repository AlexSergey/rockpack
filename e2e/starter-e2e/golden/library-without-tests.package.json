{
  "name": "library-without-tests",
  "version": "1.0.0",
  "description": "<description>",
  "keywords": [
    "library-without-tests"
  ],
  "license": "ISC",
  "author": "email@email.com",
  "exports": {
    ".": {
      "import": "./lib/esm/index.mjs",
      "require": "./lib/cjs/index.cjs",
      "types": "./dist/types/index.d.ts"
    }
  },
  "main": "./lib/cjs/index.cjs",
  "module": "./lib/esm/index.mjs",
  "types": "./dist/types/index.d.ts",
  "files": [
    "dist",
    "lib"
  ],
  "scripts": {
    "build": "node scripts.build.mts --mode=production",
    "build:example": "node example/scripts.build.mts --mode=production",
    "format": "npm run format:prettier && npm run format:code",
    "format:code": "eslint . --fix",
    "format:prettier": "prettier --write \"src/**/*.{ts,tsx,json}\"",
    "lint": "npm run lint:ts && npm run lint:code && npm run lint:deps",
    "lint:code": "eslint .",
    "lint:commit": "commitlint --config .commitlintrc.cjs --edit",
    "lint:deps": "knip",
    "lint:ts": "tsc --noEmit",
    "pre-commit": "lint-staged --config .lintstagedrc.cjs",
    "prepare": "simple-git-hooks",
    "production": "npm run lint && npm run build && npm publish",
    "start": "node example/scripts.build.mts"
  },
  "simple-git-hooks": {
    "pre-commit": "npm run pre-commit",
    "commit-msg": "npm run lint:commit"
  },
  "devDependencies": {
    "@rockpack/codestyle": "<rockpack>",
    "@rockpack/compiler": "<rockpack>",
    "@rockpack/tsconfig": "<rockpack>",
    "@types/node": "24",
    "knip": "6",
    "lint-staged": "17",
    "simple-git-hooks": "2",
    "typescript": "6"
  },
  "knip": {
    "entry": [
      "eslint.config.ts",
      ".commitlintrc.cjs",
      ".stylelintrc.cjs",
      "src/index.ts",
      "example/src/index.ts"
    ],
    "ignoreBinaries": [
      "commitlint",
      "eslint",
      "prettier",
      "tsc"
    ],
    "ignoreDependencies": [
      "@rockpack/tsconfig"
    ]
  }
}
