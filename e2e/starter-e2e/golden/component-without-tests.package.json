{
  "name": "component-without-tests",
  "version": "1.0.0",
  "description": "<description>",
  "keywords": [
    "component-without-tests"
  ],
  "license": "ISC",
  "author": "email@email.com",
  "main": "dist/index.js",
  "types": "dist/types/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node scripts.build.mts --mode=production",
    "build:example": "node example/scripts.build.mts --mode=production",
    "format": "npm run format:prettier && npm run format:code && npm run format:styles",
    "format:code": "eslint . --fix",
    "format:prettier": "prettier --write \"src/**/*.{ts,tsx,json}\"",
    "format:styles": "stylelint \"src/**/*.{css,scss}\" --fix",
    "lint": "npm run lint:ts && npm run lint:code && npm run lint:styles && npm run lint:deps",
    "lint:code": "eslint .",
    "lint:commit": "commitlint --config .commitlintrc.cjs --edit",
    "lint:deps": "knip",
    "lint:styles": "stylelint --config .stylelintrc.cjs \"src/**/*.{css,scss}\"",
    "lint:ts": "tsc --noEmit",
    "pre-commit": "lint-staged --config .lintstagedrc.cjs",
    "prepare": "simple-git-hooks",
    "production": "npm run lint && npm run build && npm publish",
    "start": "node example/scripts.build.mts"
  },
  "simple-git-hooks": {
    "pre-commit": "npm run pre-commit",
    "commit-msg": "npm run lint:commit"
  },
  "devDependencies": {
    "@rockpack/codestyle": "<rockpack>",
    "@rockpack/compiler": "<rockpack>",
    "@rockpack/tsconfig": "<rockpack>",
    "@types/node": "24",
    "@types/react": "19",
    "@types/react-dom": "19",
    "knip": "6",
    "lint-staged": "17",
    "react": "19",
    "react-dom": "19",
    "simple-git-hooks": "2",
    "typescript": "6"
  },
  "peerDependencies": {
    "react": "19",
    "react-dom": "19"
  },
  "knip": {
    "entry": [
      "eslint.config.ts",
      ".commitlintrc.cjs",
      ".stylelintrc.cjs",
      "src/index.tsx",
      "example/src/index.tsx"
    ],
    "ignoreBinaries": [
      "commitlint",
      "eslint",
      "prettier",
      "stylelint",
      "tsc"
    ],
    "ignoreDependencies": [
      "@rockpack/tsconfig"
    ]
  }
}
