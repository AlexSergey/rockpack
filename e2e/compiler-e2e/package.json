{
  "name": "@rockpack/compiler-e2e",
  "version": "9.0.0-next.2",
  "private": true,
  "description": "Builds small fixture projects with @rockpack/compiler and checks the output",
  "repository": {
    "type": "git",
    "url": "https://github.com/AlexSergey/rockpack.git"
  },
  "type": "module",
  "scripts": {
    "format": "eslint . --fix",
    "lint": "npm run lint:ts && npm run lint:code",
    "lint:code": "eslint .",
    "lint:ts": "tsc --noEmit",
    "test": "node --experimental-vm-modules --import tsx scripts.test.ts"
  },
  "dependencies": {
    "@rockpack/compiler": "9.0.0-next.2",
    "deepmerge": "4.3.1",
    "jsdom": "30.1.1",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@rockpack/codestyle": "9.0.0-next.2",
    "@rockpack/e2e-tools": "9.0.0-next.2",
    "@rockpack/tester": "9.0.0-next.2",
    "@rockpack/tsconfig": "9.0.0-next.2",
    "@types/jest": "30.0.0",
    "@types/jsdom": "30.0.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "tsx": "4.23.15"
  }
}
