{
  "name": "@rockpack/starter",
  "version": "9.0.0-next.2",
  "private": false,
  "description": "CLI scaffolding tool for React apps with zero-config CSR and SSR setup, Webpack, Jest, and ESLint",
  "keywords": [
    "cli",
    "scaffolding",
    "react",
    "ssr",
    "csr",
    "webpack",
    "typescript",
    "zero-config",
    "boilerplate",
    "rockpack"
  ],
  "homepage": "https://alexsergey.github.io/rockpack/",
  "bugs": {
    "url": "https://github.com/AlexSergey/rockpack/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AlexSergey/rockpack.git"
  },
  "license": "MIT",
  "author": "Aleksandrov Sergey <gooddev.sergey@gmail.com> (https://github.com/AlexSergey/rockpack)",
  "type": "module",
  "exports": {
    "./package.json": "./package.json"
  },
  "bin": {
    "rockpack": "./lib/bin/index.mjs"
  },
  "files": [
    "lib",
    "templates"
  ],
  "scripts": {
    "build": "npm run clean && tsx scripts.build.ts",
    "clean": "tsx scripts/clean.ts",
    "format": "npm run format:code",
    "format:code": "eslint . --fix",
    "lint": "npm run lint:ts && npm run lint:code",
    "lint:code": "eslint .",
    "lint:ts": "tsc --noEmit",
    "prepublishOnly": "npm run build",
    "production": "npm run lint && npm publish --access public",
    "test": "tsx scripts.tests.ts",
    "test:watch": "tsx scripts.tests.ts --watch"
  },
  "dependencies": {
    "@inquirer/confirm": "6.3.2",
    "@inquirer/select": "5.2.5",
    "chalk": "6.0.0",
    "change-case": "5.4.4",
    "deep-extend": "0.6.0",
    "latest-version": "9.0.0",
    "mkdirp": "3.0.1",
    "ora": "9.4.1",
    "semver": "7.8.5",
    "sort-package-json": "4.0.0",
    "validate-npm-package-name": "8.0.0",
    "yargs": "18.2.0"
  },
  "devDependencies": {
    "@rockpack/build-tools": "9.0.0-next.2",
    "@rockpack/codestyle": "9.0.0-next.2",
    "@rockpack/compiler": "9.0.0-next.2",
    "@rockpack/tester": "9.0.0-next.2",
    "@rockpack/tsconfig": "9.0.0-next.2",
    "@types/jest": "30.0.0",
    "eslint": "10.11.0",
    "expect-type": "1.4.0"
  },
  "engines": {
    "node": ">=24.15.0"
  },
  "nx": {
    "implicitDependencies": [
      "!@rockpack/codestyle",
      "!@rockpack/tester"
    ]
  }
}
