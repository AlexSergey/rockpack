{
  "name": "@rockpack/babel",
  "version": "8.0.0",
  "private": false,
  "description": "Zero-config Babel presets for React, TypeScript, and modern JavaScript with React Compiler support",
  "keywords": [
    "babel",
    "babel-preset",
    "react",
    "typescript",
    "react-compiler",
    "preset-env",
    "rockpack"
  ],
  "homepage": "https://alexsergey.github.io/rockpack/",
  "bugs": {
    "url": "https://github.com/AlexSergey/rockpack/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AlexSergey/rockpack.git"
  },
  "license": "MIT",
  "author": "Aleksandrov Sergey <gooddev.sergey@gmail.com> (https://github.com/AlexSergey/rockpack)",
  "type": "module",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "import": "./lib/esm/index.mjs",
      "require": "./lib/cjs/index.cjs"
    },
    "./plugins/import-extension": "./plugins/import-extension.cjs",
    "./plugins/rename-cjs-globals": "./plugins/rename-cjs-globals.cjs",
    "./presets/react": "./presets/react.cjs"
  },
  "main": "./lib/cjs/index.cjs",
  "module": "./lib/esm/index.mjs",
  "types": "./types/index.d.ts",
  "files": [
    "lib",
    "plugins",
    "presets",
    "types"
  ],
  "scripts": {
    "build": "npm run clean && npm run build:js && npm run build:types",
    "build:js": "tsx scripts/build.ts",
    "build:types": "tsc -p tsconfig.types.json",
    "clean": "tsx scripts/clean.ts",
    "format": "npm run format:code",
    "format:code": "eslint . --fix",
    "lint": "npm run lint:ts && npm run lint:code",
    "lint:code": "eslint .",
    "lint:ts": "tsc --noEmit",
    "prepublishOnly": "npm run build",
    "production": "npm run lint && npm publish --access public",
    "test": "node --experimental-vm-modules --import tsx scripts.tests.ts",
    "test:watch": "node --experimental-vm-modules --import tsx scripts.tests.ts --watch"
  },
  "dependencies": {
    "@babel/core": "8.0.6",
    "@babel/plugin-proposal-decorators": "8.0.2",
    "@babel/plugin-proposal-do-expressions": "8.0.1",
    "@babel/plugin-transform-modules-commonjs": "8.0.1",
    "@babel/plugin-transform-react-constant-elements": "8.0.5",
    "@babel/preset-env": "8.0.6",
    "@babel/preset-react": "8.0.1",
    "@babel/preset-typescript": "8.0.1",
    "@rockpack/utils": "8.0.0",
    "babel-plugin-polyfill-corejs3": "1.0.0",
    "babel-plugin-react-compiler": "1.0.0",
    "babel-plugin-transform-import-meta": "3.0.0",
    "babel-plugin-transform-typescript-metadata": "0.4.0",
    "deepmerge": "4.3.1"
  },
  "devDependencies": {
    "@rockpack/build-tools": "8.0.0",
    "@rockpack/codestyle": "8.0.0",
    "@rockpack/tester": "8.0.0",
    "@rockpack/tsconfig": "8.0.0",
    "@types/jest": "30.0.0",
    "babel-core-7": "npm:@babel/core@7.29.7",
    "expect-type": "1.4.0",
    "react-compiler-runtime": "1.0.0"
  },
  "peerDependencies": {
    "react-compiler-runtime": "^1.0.0"
  },
  "peerDependenciesMeta": {
    "react-compiler-runtime": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=24.11.0"
  },
  "nx": {
    "implicitDependencies": [
      "!@rockpack/codestyle",
      "!@rockpack/tester"
    ]
  }
}
