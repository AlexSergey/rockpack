{
  "name": "@rockpack/babel",
  "version": "8.0.0",
  "private": false,
  "description": "Zero-config Babel presets for React, TypeScript, and modern JavaScript with React Compiler support",
  "keywords": [
    "babel",
    "babel-preset",
    "react",
    "typescript",
    "react-compiler",
    "preset-env",
    "rockpack"
  ],
  "homepage": "https://alexsergey.github.io/rockpack/",
  "bugs": {
    "url": "https://github.com/AlexSergey/rockpack/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AlexSergey/rockpack.git"
  },
  "license": "MIT",
  "author": "Aleksandrov Sergey <gooddev.sergey@gmail.com> (https://github.com/AlexSergey/rockpack)",
  "type": "module",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "import": "./lib/esm/index.mjs",
      "require": "./lib/cjs/index.cjs"
    },
    "./plugins/import-extension": "./plugins/import-extension.cjs",
    "./plugins/rename-cjs-globals": "./plugins/rename-cjs-globals.cjs"
  },
  "main": "./lib/cjs/index.cjs",
  "module": "./lib/esm/index.mjs",
  "types": "./types/index.d.ts",
  "files": [
    "lib",
    "plugins",
    "types"
  ],
  "scripts": {
    "build": "npm run clean && npm run build:js && npm run build:types",
    "build:js": "tsx scripts/build.ts",
    "build:types": "tsc -p tsconfig.types.json",
    "clean": "tsx scripts/clean.ts",
    "format": "npm run format:code",
    "format:code": "eslint . --fix",
    "lint": "npm run lint:ts && npm run lint:code",
    "lint:code": "eslint .",
    "lint:ts": "tsc --noEmit",
    "prepublishOnly": "npm run build",
    "production": "npm run lint && npm publish --access public",
    "test": "tsx scripts.tests.ts",
    "test:watch": "tsx scripts.tests.ts --watch",
    "type-coverage": "type-coverage -p tsconfig.json"
  },
  "dependencies": {
    "@babel/core": "7.29.7",
    "@babel/plugin-proposal-decorators": "7.29.7",
    "@babel/plugin-proposal-do-expressions": "7.29.7",
    "@babel/plugin-proposal-pipeline-operator": "7.29.7",
    "@babel/plugin-transform-modules-commonjs": "7.29.7",
    "@babel/plugin-transform-react-constant-elements": "7.29.7",
    "@babel/preset-env": "7.29.7",
    "@babel/preset-react": "7.29.7",
    "@babel/preset-typescript": "7.29.7",
    "@rockpack/utils": "8.0.0",
    "@types/babel__core": "7.20.5",
    "babel-plugin-react-compiler": "1.0.0",
    "babel-plugin-transform-import-meta": "2.3.3",
    "babel-plugin-transform-typescript-metadata": "0.4.0",
    "deepmerge": "4.3.1"
  },
  "devDependencies": {
    "@rockpack/build-tools": "8.0.0",
    "@rockpack/codestyle": "8.0.0",
    "@rockpack/tester": "8.0.0",
    "@rockpack/tsconfig": "8.0.0",
    "@types/jest": "30.0.0",
    "babel-core-8": "npm:@babel/core@8.0.6",
    "expect-type": "1.4.0",
    "react-compiler-runtime": "1.0.0"
  },
  "peerDependencies": {
    "react-compiler-runtime": "^1.0.0"
  },
  "peerDependenciesMeta": {
    "react-compiler-runtime": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "nx": {
    "implicitDependencies": [
      "!@rockpack/codestyle",
      "!@rockpack/tester"
    ]
  },
  "typeCoverage": {
    "atLeast": 99,
    "ignoreFiles": [
      "src/**/*.spec.ts",
      "src/**/__fixtures__/**",
      "src/**/__mocks__/**",
      "types/**"
    ],
    "strict": true
  }
}
