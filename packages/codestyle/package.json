{
  "name": "@rockpack/codestyle",
  "version": "8.0.0",
  "private": false,
  "description": "Opinionated ESLint, Prettier, and Stylelint configuration for React and TypeScript projects",
  "keywords": [
    "eslint",
    "prettier",
    "stylelint",
    "typescript",
    "linting",
    "code-style",
    "react",
    "rockpack"
  ],
  "homepage": "https://alexsergey.github.io/rockpack/",
  "bugs": {
    "url": "https://github.com/AlexSergey/rockpack/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AlexSergey/rockpack.git"
  },
  "license": "MIT",
  "author": "Aleksandrov Sergey <gooddev.sergey@gmail.com> (https://github.com/AlexSergey/rockpack)",
  "type": "module",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "default": "./lib/esm/index.mjs"
    },
    "./commitlint": {
      "types": "./types/commitlint.d.ts",
      "default": "./lib/esm/commitlint.mjs"
    },
    "./stylelint": {
      "types": "./types/stylelint.d.ts",
      "default": "./lib/esm/stylelint.mjs"
    }
  },
  "main": "./lib/esm/index.mjs",
  "module": "./lib/esm/index.mjs",
  "types": "./types/index.d.ts",
  "files": [
    "lib",
    "types"
  ],
  "scripts": {
    "build": "npm run clean && npm run build:js && npm run build:types",
    "build:js": "tsx scripts/build.ts",
    "build:types": "tsc -p tsconfig.types.json",
    "clean": "tsx scripts/clean.ts",
    "format": "npm run format:code",
    "format:code": "eslint . --fix",
    "lint": "npm run lint:ts && npm run lint:code",
    "lint:code": "eslint .",
    "lint:ts": "tsc --noEmit",
    "prepublishOnly": "npm run build",
    "production": "npm run lint && npm publish --access public",
    "test": "tsx scripts.tests.ts",
    "test:watch": "tsx scripts.tests.ts --watch"
  },
  "dependencies": {
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@commitlint/types": "21.2.3",
    "@eslint-react/eslint-plugin": "5.20.8",
    "@eslint/js": "10.0.1",
    "@eslint/json": "2.1.0",
    "@rockpack/utils": "8.0.0",
    "@typescript-eslint/eslint-plugin": "8.70.1",
    "@typescript-eslint/parser": "8.70.1",
    "eslint": "10.11.0",
    "eslint-config-flat-gitignore": "2.4.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-check-file": "3.3.2",
    "eslint-plugin-import-lite": "0.6.0",
    "eslint-plugin-jest": "29.16.6",
    "eslint-plugin-no-only-tests": "3.4.0",
    "eslint-plugin-package-json": "1.10.0",
    "eslint-plugin-perfectionist": "5.12.1",
    "eslint-plugin-prettier": "5.5.6",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-regexp": "3.3.1",
    "eslint-plugin-sonarjs": "4.2.1",
    "eslint-plugin-unicorn": "76.0.0",
    "globals": "17.12.0",
    "prettier": "3.9.9",
    "stylelint": "17.15.0",
    "stylelint-config-clean-order": "10.0.0",
    "stylelint-config-prettier-scss": "1.0.0",
    "stylelint-config-recommended-scss": "17.0.1",
    "stylelint-config-standard-scss": "17.0.0",
    "stylelint-config-tailwindcss": "1.0.1",
    "stylelint-scss": "7.3.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1"
  },
  "devDependencies": {
    "@rockpack/build-tools": "8.0.0",
    "@rockpack/tester": "8.0.0",
    "@rockpack/tsconfig": "8.0.0",
    "@types/jest": "30.0.0",
    "expect-type": "1.4.0"
  },
  "engines": {
    "node": ">=24.11.0"
  },
  "nx": {
    "implicitDependencies": [
      "!@rockpack/tester"
    ]
  }
}
