{
  "name": "@rockpack/tester",
  "version": "8.0.0",
  "private": false,
  "description": "Pre-configured Jest setup for React and TypeScript with testing-library and best-practice defaults",
  "keywords": [
    "jest",
    "testing-library",
    "react",
    "typescript",
    "test-runner",
    "jest-config",
    "rockpack"
  ],
  "homepage": "https://alexsergey.github.io/rockpack/",
  "bugs": {
    "url": "https://github.com/AlexSergey/rockpack/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AlexSergey/rockpack.git"
  },
  "license": "MIT",
  "author": "Aleksandrov Sergey <gooddev.sergey@gmail.com> (https://github.com/AlexSergey/rockpack)",
  "type": "module",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "import": "./lib/esm/index.mjs",
      "require": "./lib/cjs/index.cjs"
    }
  },
  "main": "./lib/cjs/index.cjs",
  "module": "./lib/esm/index.mjs",
  "types": "./types/index.d.ts",
  "files": [
    "lib",
    "types"
  ],
  "scripts": {
    "build": "npm run clean && npm run build:js && npm run build:types",
    "build:js": "tsx scripts/build.ts",
    "build:types": "tsc -p tsconfig.types.json",
    "clean": "tsx scripts/clean.ts",
    "format": "npm run format:code",
    "format:code": "eslint . --fix",
    "lint": "npm run lint:ts && npm run lint:code",
    "lint:code": "eslint .",
    "lint:ts": "tsc --noEmit",
    "prepublishOnly": "npm run build",
    "production": "npm run lint && npm publish --access public",
    "test": "tsx scripts.tests.ts",
    "test:watch": "tsx scripts.tests.ts --watch",
    "type-coverage": "type-coverage -p tsconfig.json"
  },
  "dependencies": {
    "@babel/core": "8.0.6",
    "@jest/types": "30.4.1",
    "@rockpack/babel": "8.0.0",
    "@rockpack/utils": "8.0.0",
    "@types/jest": "30.0.0",
    "babel-jest": "30.4.1",
    "deep-extend": "0.6.0",
    "identity-obj-proxy": "3.0.0",
    "jest": "30.4.2",
    "jest-environment-jsdom": "30.4.1",
    "jest-html-reporters": "3.1.7",
    "typescript": "6.0.3"
  },
  "devDependencies": {
    "@rockpack/build-tools": "8.0.0",
    "@rockpack/codestyle": "8.0.0",
    "@rockpack/tsconfig": "8.0.0",
    "eslint": "10.4.0",
    "expect-type": "1.4.0"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "nx": {
    "implicitDependencies": [
      "!@rockpack/codestyle"
    ]
  },
  "typeCoverage": {
    "atLeast": 99,
    "ignoreFiles": [
      "src/**/*.spec.ts",
      "src/**/__fixtures__/**",
      "src/**/__mocks__/**",
      "types/**"
    ],
    "strict": true
  }
}
