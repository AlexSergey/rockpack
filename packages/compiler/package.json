{
  "name": "@rockpack/compiler",
  "version": "8.0.0",
  "private": false,
  "description": "Zero-config Webpack bundler for React apps with CSR, SSR, backend, and library build modes",
  "keywords": [
    "webpack",
    "bundler",
    "react",
    "ssr",
    "csr",
    "typescript",
    "zero-config",
    "rockpack"
  ],
  "homepage": "https://alexsergey.github.io/rockpack/",
  "bugs": {
    "url": "https://github.com/AlexSergey/rockpack/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AlexSergey/rockpack.git"
  },
  "license": "MIT",
  "author": "Aleksandrov Sergey <gooddev.sergey@gmail.com> (https://github.com/AlexSergey/rockpack)",
  "type": "module",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "import": "./lib/esm/index.mjs",
      "require": "./lib/cjs/index.cjs"
    }
  },
  "main": "./lib/cjs/index.cjs",
  "module": "./lib/esm/index.mjs",
  "types": "./types/index.d.ts",
  "files": [
    "banner",
    "configs",
    "index.ejs",
    "lib",
    "types"
  ],
  "scripts": {
    "build": "npm run clean && npm run build:js && npm run build:types",
    "build:js": "tsx scripts/build.ts",
    "build:types": "tsc -p tsconfig.types.json",
    "clean": "tsx scripts/clean.ts",
    "format": "npm run format:code",
    "format:code": "eslint . --fix",
    "lint": "npm run lint:ts && npm run lint:code",
    "lint:code": "eslint .",
    "lint:ts": "tsc --noEmit",
    "prepublishOnly": "npm run build",
    "production": "npm run lint && npm publish --access public",
    "test": "node --experimental-vm-modules --import tsx scripts.tests.ts",
    "test:watch": "node --experimental-vm-modules --import tsx scripts.tests.ts --watch"
  },
  "dependencies": {
    "@babel/core": "8.0.6",
    "@babel/plugin-transform-modules-commonjs": "8.0.1",
    "@graphql-tools/webpack-loader": "7.0.1",
    "@mdx-js/loader": "3.1.1",
    "@rockpack/babel": "8.0.0",
    "@rockpack/utils": "8.0.0",
    "@svgr/webpack": "8.1.0",
    "@tailwindcss/postcss": "4.3.3",
    "ansi-colors": "4.1.3",
    "autoprefixer": "10.6.1",
    "babel-loader": "10.1.1",
    "case-sensitive-paths-webpack-plugin": "2.4.0",
    "copy-webpack-plugin": "14.0.0",
    "css-loader": "7.1.5",
    "css-minimizer-webpack-plugin": "8.0.0",
    "deep-extend": "0.6.0",
    "dotenv-webpack": "9.0.0",
    "dts-css-modules-loader": "2.0.2",
    "eslint-webpack-plugin": "6.0.0",
    "find-free-port": "2.0.0",
    "find-package-json": "1.2.0",
    "glob": "13.0.6",
    "html-loader": "5.1.0",
    "html-webpack-plugin": "5.6.8",
    "image-minimizer-webpack-plugin": "5.0.0",
    "less": "4.9.1",
    "less-loader": "13.0.0",
    "livereload": "0.10.3",
    "markdown-loader": "8.0.0",
    "mini-css-extract-plugin": "2.10.2",
    "mkdirp": "3.0.1",
    "node-loader": "2.1.0",
    "nodemon": "3.1.14",
    "nodemon-webpack-plugin": "4.8.2",
    "postcss": "8.5.28",
    "postcss-custom-media": "12.0.1",
    "postcss-loader": "8.2.1",
    "postcss-media-minmax": "5.0.0",
    "rimraf": "6.1.3",
    "sass": "1.105.0",
    "sass-loader": "17.0.1",
    "shader-loader": "1.3.1",
    "sharp": "0.35.4",
    "source-map-support": "0.5.21",
    "style-loader": "4.0.0",
    "stylelint-webpack-plugin": "5.1.0",
    "svgo": "4.1.0",
    "svgo-loader": "5.0.0",
    "terser-webpack-plugin": "5.6.1",
    "typescript": "6.0.3",
    "wasm-loader": "1.3.0",
    "webpack": "5.111.1",
    "webpack-dev-server": "6.0.0",
    "webpack-node-externals": "3.0.0",
    "yargs": "18.2.0"
  },
  "devDependencies": {
    "@rockpack/build-tools": "8.0.0",
    "@rockpack/codestyle": "8.0.0",
    "@rockpack/tester": "8.0.0",
    "@rockpack/tsconfig": "8.0.0",
    "@types/jest": "30.0.0",
    "eslint": "10.11.0",
    "expect-type": "1.4.0",
    "jest-environment-jsdom": "30.5.2"
  },
  "engines": {
    "node": ">=24.11.0"
  },
  "nx": {
    "implicitDependencies": [
      "!@rockpack/codestyle",
      "!@rockpack/tester"
    ]
  }
}
