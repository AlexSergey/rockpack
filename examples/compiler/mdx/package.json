{
  "name": "@rockpack/example-compiler-mdx",
  "version": "9.0.0-next.2",
  "description": "Rockpack example: mdx",
  "license": "MIT",
  "author": "Aleksandrov Sergey <gooddev.sergey@gmail.com> (https://github.com/AlexSergey/rockpack)",
  "scripts": {
    "build": "cross-env NODE_ENV=production node scripts.build.mts",
    "format": "npm run format:code",
    "format:code": "eslint . --fix",
    "lint": "npm run lint:ts && npm run lint:code",
    "lint:code": "eslint .",
    "lint:ts": "tsc --noEmit",
    "start": "cross-env NODE_ENV=development node scripts.build.mts"
  },
  "dependencies": {
    "@mdx-js/react": "3.1.1",
    "prism-react-renderer": "2.4.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-live": "5.0.0"
  },
  "devDependencies": {
    "@rockpack/codestyle": "9.0.0-next.2",
    "@rockpack/compiler": "9.0.0-next.2",
    "@rockpack/tsconfig": "9.0.0-next.2",
    "@types/mdx": "2.0.14",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0"
  }
}
