{
  "name": "@rockpack/example-compiler-advanced-config-elm-support",
  "version": "9.0.0-next.1",
  "description": "Rockpack example: advanced-config-elm-support",
  "license": "MIT",
  "author": "Aleksandrov Sergey <gooddev.sergey@gmail.com> (https://github.com/AlexSergey/rockpack)",
  "scripts": {
    "build": "cross-env NODE_ENV=production node scripts.build.mts",
    "format": "npm run format:code",
    "format:code": "eslint . --fix",
    "lint": "npm run lint:ts && npm run lint:code",
    "lint:code": "eslint .",
    "lint:ts": "tsc --noEmit",
    "start": "cross-env NODE_ENV=development node scripts.build.mts"
  },
  "dependencies": {
    "elm": "0.19.1-6"
  },
  "devDependencies": {
    "@rockpack/codestyle": "9.0.0-next.1",
    "@rockpack/compiler": "9.0.0-next.1",
    "@rockpack/tsconfig": "9.0.0-next.1",
    "elm-webpack-loader": "8.0.0",
    "webpack-notifier": "1.17.0"
  }
}
