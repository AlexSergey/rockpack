{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreWorkspaces": [
    "book",
    "examples/**"
  ],
  "ignoreBinaries": [
    "yarnpkg"
  ],
  "workspaces": {
    ".": {
      "entry": [
        "tools/**/*.ts"
      ],
      "project": [
        "*.{ts,mjs}",
        "tools/**/*.ts"
      ],
      "ignoreDependencies": [
        "@babel/core",
        "cross-env"
      ]
    },
    "packages/*": {
      "entry": [
        "src/index.ts",
        "src/**/*.spec.ts",
        "scripts/*.ts"
      ],
      "project": [
        "src/**/*.ts",
        "scripts/**/*.ts",
        "*.ts"
      ]
    },
    "packages/babel": {
      "entry": [
        "src/index.ts",
        "src/**/*.spec.ts",
        "scripts/*.ts"
      ],
      "project": [
        "src/**/*.ts",
        "scripts/**/*.ts",
        "*.ts"
      ],
      "ignoreDependencies": [
        "@babel/*",
        "babel-core-7",
        "babel-plugin-*",
        "react-compiler-runtime"
      ]
    },
    "packages/codestyle": {
      "entry": [
        "src/index.ts",
        "src/commitlint.ts",
        "src/stylelint.ts",
        "src/**/*.spec.ts",
        "scripts/*.ts"
      ],
      "project": [
        "src/**/*.ts",
        "scripts/**/*.ts",
        "*.ts"
      ],
      "ignoreDependencies": [
        "@commitlint/*",
        "stylelint-*"
      ]
    },
    "packages/compiler": {
      "entry": [
        "src/index.ts",
        "src/**/*.spec.ts",
        "src/plugins/reloader/ssr.ts",
        "configs/postcss.config.cjs",
        "scripts/*.ts"
      ],
      "project": [
        "src/**/*.ts",
        "configs/*.cjs",
        "scripts/**/*.ts",
        "*.ts"
      ],
      "ignore": [
        "src/__fixtures__/**"
      ],
      "ignoreDependencies": [
        "@babel/*",
        "@graphql-tools/webpack-loader",
        "@svgr/webpack",
        "babel-loader",
        "css-loader",
        "dts-css-modules-loader",
        "html-loader",
        "less-loader",
        "markdown-loader",
        "node-loader",
        "postcss-loader",
        "sass-loader",
        "shader-loader",
        "style-loader",
        "svgo-loader",
        "wasm-loader",
        "sharp",
        "svgo",
        "source-map-support"
      ]
    },
    "packages/starter": {
      "entry": [
        "src/bin/index.ts",
        "src/**/*.spec.ts"
      ],
      "project": [
        "src/**/*.ts",
        "*.ts"
      ]
    },
    "packages/tester": {
      "entry": [
        "src/index.ts",
        "src/**/*.spec.ts",
        "src/modules/file-transformer.ts",
        "src/modules/identity-obj-proxy.ts",
        "scripts/*.ts"
      ],
      "project": [
        "src/**/*.ts",
        "scripts/**/*.ts",
        "*.ts"
      ],
      "ignoreDependencies": [
        "@babel/core",
        "babel-jest",
        "jest-environment-jsdom",
        "jest-html-reporters"
      ]
    },
    "packages/tsconfig": {
      "entry": [],
      "project": []
    },
    "e2e/*": {
      "entry": [
        "src/**/*.spec.ts"
      ],
      "project": [
        "src/**/*.ts",
        "*.ts"
      ]
    },
    "packages/utils": {
      "entry": [
        "src/index.ts",
        "src/**/*.spec.ts",
        "src/polyfills/text-encoder.fix.ts",
        "scripts/*.ts"
      ],
      "project": [
        "src/**/*.ts",
        "scripts/**/*.ts",
        "*.ts"
      ]
    },
    "e2e/compiler-e2e": {
      "entry": [
        "src/**/*.spec.ts",
        "fixtures/*/scripts.*.mts",
        "fixtures/*/eslint.config.ts",
        "fixtures/*/src/**/*.{ts,tsx}"
      ],
      "project": [
        "src/**/*.ts",
        "fixtures/**/*.{ts,tsx}",
        "*.ts"
      ]
    },
    "e2e/starter-e2e": {
      "entry": [
        "src/**/*.spec.ts"
      ],
      "project": [
        "src/**/*.ts",
        "*.ts"
      ],
      "ignoreDependencies": [
        "@issr/*",
        "@koa/router",
        "@testing-library/*",
        "@types/koa",
        "@types/koa-static",
        "@types/koa__router",
        "@types/serialize-javascript",
        "@unhead/react",
        "axios-mock-adapter",
        "koa",
        "koa-static",
        "react",
        "react-dom",
        "serialize-javascript",
        "source-map",
        "stylelint-config-*"
      ]
    },
    "tools/build-tools": {
      "project": [
        "src/**/*.ts"
      ],
      "ignoreDependencies": [
        "@babel/plugin-transform-modules-commonjs",
        "@babel/preset-env",
        "@babel/preset-typescript",
        "@rockpack/babel",
        "babel-plugin-transform-import-meta"
      ]
    },
    "e2e/tools": {
      "entry": [
        "src/**/*.spec.ts"
      ],
      "project": [
        "src/**/*.ts",
        "*.ts"
      ]
    }
  }
}
