{
  "name": "rockpack",
  "version": "8.0.0",
  "private": true,
  "license": "MIT",
  "workspaces": [
    "book",
    "e2e/*",
    "examples/compiler/*",
    "examples/tester/*",
    "packages/*",
    "tools/build-tools"
  ],
  "scripts": {
    "build": "lerna run build --scope=@rockpack/utils --scope=@rockpack/babel --scope=@rockpack/codestyle --scope=@rockpack/compiler --scope=@rockpack/tester --scope=@rockpack/starter",
    "build:babel": "lerna run build --scope=@rockpack/babel",
    "build:codestyle": "lerna run build --scope=@rockpack/codestyle",
    "build:compiler": "lerna run build --scope=@rockpack/compiler",
    "build:utils": "lerna run build --scope=@rockpack/utils",
    "build:tester": "lerna run build --scope=@rockpack/tester",
    "build:starter": "lerna run build --scope=@rockpack/starter",
    "lint": "lerna run lint",
    "format": "lerna run format",
    "prepare": "simple-git-hooks",
    "production": "lerna run production",
    "test": "lerna run test --stream",
    "test:unit": "lerna run test --scope=@rockpack/babel --scope=@rockpack/utils --scope=@rockpack/tester --scope=@rockpack/codestyle --scope=@rockpack/starter --scope=@rockpack/compiler",
    "cloc": "tsx cloc.ts",
    "updater": "tsx updater.ts",
    "version:set": "tsx version.ts",
    "lint:deps": "syncpack lint && knip",
    "type-coverage": "lerna run type-coverage --scope=@rockpack/babel --scope=@rockpack/codestyle --scope=@rockpack/compiler --scope=@rockpack/starter --scope=@rockpack/tester --scope=@rockpack/utils",
    "e2e": "npm test -w e2e/babel-e2e && npm test -w e2e/packaging-e2e && npm test -w e2e/compiler-e2e -- frontend backend library config assets lint examples && npm test -w e2e/starter-e2e -- cli generation quality",
    "e2e:runtime": "npm test -w e2e/starter-e2e -- runtime && npm test -w e2e/compiler-e2e -- dev",
    "e2e:latest": "npm test -w e2e/packaging-e2e && E2E_MODE=latest npm test -w e2e/starter-e2e -- quality runtime"
  },
  "simple-git-hooks": {
    "pre-commit": "npx lint-staged",
    "pre-push": "npm run lint && npm run test:unit"
  },
  "devDependencies": {
    "@babel/core": "8.0.6",
    "@inquirer/checkbox": "5.2.1",
    "@types/node": "24.13.6",
    "@types/semver": "7.8.0",
    "@types/yargs": "17.0.35",
    "cross-env": "10.1.0",
    "eslint": "10.4.0",
    "knip": "6.38.0",
    "latest-version": "9.0.0",
    "lerna": "10.0.1",
    "lint-staged": "17.5.1",
    "semver": "7.8.1",
    "simple-git-hooks": "2.13.1",
    "sort-package-json": "4.0.0",
    "syncpack": "15.3.3",
    "tsx": "4.23.15",
    "type-coverage": "2.30.1",
    "typescript": "6.0.3",
    "yargs": "18.0.0"
  },
  "engines": {
    "node": ">=24.11.0"
  }
}
